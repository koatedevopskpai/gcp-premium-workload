# =============================================================================
# Terraform Variables Example — SecondWave ML/AI Platform
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.
# cp terraform.tfvars.example terraform.tfvars

# --- Project & Environment ---
project_id = "secondwave-dev"        # GCP project ID
region     = "europe-west2"          # London — UK data residency
environment = "dev"                  # dev | staging | prod

# --- BigQuery ---
# bigquery_datasets — defined in the default, override per environment
# See variables.tf for the full structure

