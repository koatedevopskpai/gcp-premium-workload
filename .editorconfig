# =============================================================================
# EditorConfig — Cross-Editor Code Style
# =============================================================================
# ARCHITECTURE DECISION: EditorConfig ensures consistent formatting across
# all editors and IDEs. This is the first line of defence against style
# nitpicks in PR reviews.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.tf]
indent_size = 2
indent_style = space
max_line_length = 120

[*.{tfvars,tf.json}]
indent_size = 2
indent_style = space

[*.{yaml,yml}]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.{json,js}]
indent_size = 2
indent_style = space

[*.go]
indent_size = 4
indent_style = tab

[*.sh]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab
indent_size = 4

[*.sql]
indent_size = 2
indent_style = space

[{*.bat,*.ps1,*.cmd}]
end_of_line = crlf
indent_size = 4
indent_style = space

[.gitignore]
indent_style = unset
